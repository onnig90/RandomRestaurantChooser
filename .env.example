# PostgreSQL — Neon connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=<random 256-bit hex string>

# Google Maps Platform
# Server-side key for Places / Routes / Geocoding / Address Validation web services
GOOGLE_MAPS_SERVER_API_KEY=<server key from Google Cloud Console>
# Browser-safe key for lazy-loaded Maps JavaScript / Maps Embed fallback
GOOGLE_MAPS_BROWSER_API_KEY=<browser key from Google Cloud Console>

# Backward-compatible fallback used by older code paths if needed
GOOGLE_PLACES_API_KEY=<optional legacy server key>
GOOGLE_PLACES_BASE_URL=https://maps.googleapis.com/maps/api/place

# App
APP_BASE_URL=https://randomrestaurantchooser.vercel.app
NODE_ENV=production
